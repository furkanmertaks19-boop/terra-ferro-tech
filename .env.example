# Database
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/terraferrotech?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/terraferrotech?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# One-time bootstrap only (empty User table). Not used after the first SUPER_ADMIN exists.
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""

# Optional CLI bootstrap: npm run create-super-admin
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD=""

# Cloudinary — never prefix API secret with NEXT_PUBLIC_
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional
MAX_TECHNICAL_PDF_BYTES="20971520"

# Optional. Google Search Console HTML-tag verification token.
# Add it when Google issues the code. Do not invent a value.
GOOGLE_SITE_VERIFICATION=""

# Optional. Set to "false" to noindex a deployment (preview/staging).
# Production Vercel env indexes by default; preview deployments stay noindex.
# SEO_INDEXING=""
